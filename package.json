{
  "name": "swiftly-io",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "pwa:preview": "next build && next start",
    "invites": "node --no-warnings scripts/invites/create.ts",
    "db:status": "node --no-warnings scripts/db/migrate.ts --status",
    "db:migrate": "node --no-warnings scripts/db/migrate.ts",
    "db:bundle": "node --no-warnings scripts/db/bundle.ts",
    "db:seed": "node --no-warnings scripts/db/seed.ts",
    "db:schema": "node --no-warnings scripts/db/schema.ts",
    "db:check-0007": "node --no-warnings scripts/db/check-0007.ts",
    "db:check-espaces": "node --no-warnings scripts/db/check-espaces.ts",
    "lint": "eslint",
    "test": "node --test \"tests/**/*.test.ts\"",
    "scan": "semgrep scan --error --severity=ERROR --metrics=off --disable-version-check --config ./semgrep.yml",
    "scan:full": "semgrep scan --error --severity=ERROR --metrics=off --config ./semgrep.yml --config p/typescript --config p/react --config p/nextjs --config p/owasp-top-ten --config p/secrets"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.4",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "^16.3.3",
    "pg": "^8.23.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
