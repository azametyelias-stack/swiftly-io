# ==============================================================================
# Swiftly.io — environment variables template
# ==============================================================================
# SECURITY MASTERPLAN — Point 1: every secret lives in an env var, never in code.
#
# Setup:
#   1. Copy this file to .env.local   ->   cp .env.example .env.local
#   2. Fill in the real values (Supabase / Upstash / Sentry dashboards).
#   3. NEVER commit .env.local — only this .env.example is tracked by git.
#   4. Mirror the same keys in Vercel -> Settings -> Environment Variables.
#
# Naming rule:
#   NEXT_PUBLIC_*  -> inlined into the browser bundle. PUBLIC, no secrets.
#   everything else -> server-only, read via lib/env/server.ts.
# ==============================================================================

# ------------------------------------------------------------------------------
# MVP — required
# ------------------------------------------------------------------------------

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.fake.anon-key
# service_role secret — bypasses RLS, SERVER ONLY. Enables the consent audit trail.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.fake.service-role-key

# Upstash Redis (REST) — rate limiting (Point 3), caching
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXx

# Sentry — error monitoring (Point 15)
SENTRY_DSN=https://0000000000000000@o000000.ingest.sentry.io/0000000

# Public app origin (used for absolute URLs / redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# MVP — optional (feature stays inert until set)
# ------------------------------------------------------------------------------

# Google Analytics 4 — gtag only loads after analytics consent (Consent Mode v2).
# Empty ⇒ GoogleAnalytics component renders nothing.
NEXT_PUBLIC_GA_ID=

# Admin allow-list for requireAdmin() — comma-separated auth.users ids.
# Empty ⇒ no admin endpoints are reachable.
ADMIN_USER_IDS=

# Invite-code pepper (Point 19). A long random string — `openssl rand -base64 48`.
# Keyed into the HMAC that hashes 6-digit invite codes so a DB leak alone can't
# brute-force them. SERVER ONLY, never in the DB. Required once the auth screens
# ship; lib/auth/invite-codes.ts throws without it.
INVITE_CODE_PEPPER=

# Daily cron secret (D2 — recurring templates + monthly account fees).
# `POST /api/cron/run` requires `Authorization: Bearer <CRON_SECRET>`; Vercel Cron
# sends it automatically once this var is set (see vercel.json). Empty ⇒ the
# endpoint 404s and no recurrence/fee rows are generated. `openssl rand -base64 32`.
CRON_SECRET=

# CORS allow-list override (Point 13). Comma-separated origins. When set it
# REPLACES the built-in list — use it for preview / staging deployments, e.g.
#   CORS_ALLOWED_ORIGINS=https://staging.swiftly.io,https://pr-42.vercel.app
# Empty ⇒ the built-in list applies (localhost in dev, *.swiftly.io in prod).
CORS_ALLOWED_ORIGINS=

# Log level (Point 15): debug | info | warn | error. Empty ⇒ info.
# Structured JSON logs go to stdout/stderr (Vercel log drains). Every payload is
# redacted by lib/log/logger.ts — passwords / tokens / keys never reach a log.
LOG_LEVEL=

# ------------------------------------------------------------------------------
# Phase 2 — structure ready, NOT used yet ("code ready, not used")
# ------------------------------------------------------------------------------

# Paystack — payments + webhook signature verification (Point 17)
# Point 7: pk_ is the PUBLIC key (NEXT_PUBLIC_), sk_ / whsec_ are SECRETS (no prefix).
# PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# PAYSTACK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google OAuth (if social login lands post-MVP) — client id is PUBLIC, secret is not.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Transactional email (SendGrid) — email confirmation (Point 19)
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxx.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=no-reply@swiftly.io

# SMS provider — phone OTP (Point 19, Phase 2)
# SMS_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SMS_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SMS_FROM_NUMBER=+22890000000
